    "@nuxtjs/seo": "^6.0.1",
    "@vueuse/core": "15.0.0",
    "lenis": "^1.3.27",
    "nuxt": "^4.6.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
